# قاعدة البيانات (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/madaar?schema=public"
# اتصال مباشر للترحيلات (مطلوب مع Supabase pooler، ويمكن أن يساوي DATABASE_URL محلياً)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/madaar?schema=public"

# سر توقيع الجلسات — 32 حرفاً على الأقل (openssl rand -base64 48)
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# تثبيت تاريخ «اليوم» بتوقيت الرياض للاختبارات والعروض (YYYY-MM-DD). يُترك فارغاً في الإنتاج.
APP_FIXED_TODAY=""

